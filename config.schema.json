{
  "pluginAlias": "TryFi",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "required": ["username", "password"],
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "TryFi"
      },
      "username": {
        "title": "TryFi Email",
        "type": "string",
        "placeholder": "your@email.com"
      },
      "password": {
        "title": "TryFi Password",
        "type": "string",
        "placeholder": "password"
      },
      "pollingInterval": {
        "title": "Polling Interval (seconds)",
        "type": "integer",
        "default": 60,
        "minimum": 30,
        "maximum": 300,
        "description": "How often to check for updates (30-300 seconds, default: 60)"
      },
      "escapeAlertType": {
        "title": "Escape Alert Type",
        "type": "string",
        "default": "leak",
        "oneOf": [
          {
            "title": "Leak Sensor (Critical)",
            "enum": ["leak"]
          },
          {
            "title": "Motion Sensor (Standard)",
            "enum": ["motion"]
          }
        ],
        "description": "How escape alerts appear in HomeKit"
      },
      "ignoredPets": {
        "title": "Ignored Pets",
        "type": "array",
        "items": {
          "type": "string",
          "title": "Pet Name"
        },
        "description": "List of pet names to ignore (will not create HomeKit accessories or poll for updates)"
      },
      "escapeConfirmations": {
        "title": "Escape Confirmations",
        "type": "integer",
        "default": 2,
        "oneOf": [
          {
            "title": "1 — Immediate",
            "enum": [1]
          },
          {
            "title": "2 — Balanced (default)",
            "enum": [2]
          },
          {
            "title": "3 — Conservative",
            "enum": [3]
          }
        ],
        "description": "Consecutive 'out of zone' readings required before triggering escape alert"
      },
      "escapeCheckInterval": {
        "title": "Escape Check Interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 10,
        "maximum": 120,
        "description": "How quickly to re-check when potential escape detected (faster than normal polling)"
      },
      "offlineAlertMinutes": {
        "title": "Collar Offline Alert (minutes)",
        "type": "integer",
        "default": 15,
        "minimum": 1,
        "maximum": 60,
        "description": "How long the collar must be offline before alerting. Set alert type to 'Disabled' to turn off."
      },
      "offlineAlertType": {
        "title": "Collar Offline Alert Type",
        "type": "string",
        "default": "motion",
        "oneOf": [
          {
            "title": "Motion Sensor (Standard)",
            "enum": ["motion"]
          },
          {
            "title": "Leak Sensor (Critical)",
            "enum": ["leak"]
          },
          {
            "title": "Disabled",
            "enum": ["none"]
          }
        ],
        "description": "How collar offline alerts appear in HomeKit. Select 'Disabled' to turn off."
      }
    }
  },
  "layout": [
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "username",
        { "key": "password", "type": "password" }
      ]
    },
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "pollingInterval",
        "escapeAlertType"
      ]
    },
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "escapeConfirmations",
        "escapeCheckInterval"
      ]
    },
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "offlineAlertMinutes",
        "offlineAlertType"
      ]
    },
    {
      "key": "ignoredPets",
      "type": "array",
      "title": "Ignored Pets",
      "description": "Add pet names to exclude from HomeKit (e.g., 'Charlie')",
      "items": [
        {
          "type": "string",
          "placeholder": "Pet name"
        }
      ]
    }
  ]
}
