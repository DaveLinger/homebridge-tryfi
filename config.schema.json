{
  "pluginAlias": "TryFi",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "required": ["username", "password", "escapeConfirmations"],
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "TryFi"
      },
      "username": {
        "title": "TryFi Email",
        "type": "string",
        "placeholder": "your@email.com"
      },
      "password": {
        "title": "TryFi Password",
        "type": "string",
        "placeholder": "password"
      },
      "pollingInterval": {
        "title": "Polling Interval (seconds)",
        "type": "integer",
        "default": 60,
        "minimum": 30,
        "maximum": 300,
        "description": "How often to check for updates (30-300 seconds, default: 60)"
      },
      "escapeAlertType": {
        "title": "Escape Alert Type",
        "type": "string",
        "default": "leak",
        "oneOf": [
          {
            "title": "Leak Sensor (Critical)",
            "enum": ["leak"]
          },
          {
            "title": "Motion Sensor (Standard)",
            "enum": ["motion"]
          }
        ],
        "description": "How escape alerts appear in HomeKit"
      },
      "ignoredPets": {
        "title": "Ignored Pets",
        "type": "array",
        "items": {
          "type": "string",
          "title": "Pet Name"
        },
        "description": "List of pet names to ignore (will not create HomeKit accessories or poll for updates)"
      },
      "escapeConfirmations": {
        "title": "Escape Confirmations",
        "type": "integer",
        "default": 2,
        "enum": [1, 2, 3],
        "description": "1 = immediate, 2 = balanced, 3 = conservative"
      },
      "escapeCheckInterval": {
        "title": "Escape Check Interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 10,
        "maximum": 120,
        "description": "Seconds between re-checks when a potential escape is detected"
      },
      "offlineAlertMinutes": {
        "title": "Collar Offline Alert (minutes)",
        "type": "integer",
        "default": 15,
        "minimum": 1,
        "maximum": 60,
        "description": "Minutes offline before alerting (1-60)"
      },
      "offlineAlertType": {
        "title": "Collar Offline Alert Type",
        "type": "string",
        "default": "motion",
        "oneOf": [
          {
            "title": "Motion Sensor (Standard)",
            "enum": ["motion"]
          },
          {
            "title": "Leak Sensor (Critical)",
            "enum": ["leak"]
          }
        ],
        "description": "Leave blank to disable offline alerts"
      },
      "apiUnreachableAlertMinutes": {
        "title": "API Unreachable Alert (minutes)",
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 60,
        "description": "Minutes the TryFi API must be unreachable before flagging a fault (StatusFault) on each pet's Escape Alert sensor"
      }
    }
  },
  "layout": [
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "username",
        { "key": "password", "type": "password" }
      ]
    },
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "escapeAlertType",
        "pollingInterval"
      ]
    },
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "escapeConfirmations",
        "escapeCheckInterval"
      ]
    },
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "offlineAlertType",
        "offlineAlertMinutes"
      ]
    },
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "apiUnreachableAlertMinutes"
      ]
    },
    {
      "key": "ignoredPets",
      "type": "array",
      "title": "Ignored Pets",
      "description": "Add pet names to exclude from HomeKit (e.g., 'Charlie')",
      "items": [
        {
          "type": "string",
          "placeholder": "Pet name"
        }
      ]
    }
  ]
}
